    {
        "id": "331fae65e437fabd",
        "type": "function",
        "z": "f8e306b2f76e8599",
        "name": "Параметри запиту",
        "func": "const p = msg.payload;\n\nmsg.params = [\n    msg.ts,\n    msg.bin,\n    p.d,\n    p.h,\n    p.fill,\n    p.fill_ema,\n    p.rate,\n    p.t100,\n    p.alarm,\n    Date.now() - msg.ts\n];\n\n// Тимчасова перевірка\nnode.warn(msg.params);\n\nreturn msg;",
