    {
        "id": "330d0907827151d9",
        "type": "comment",
        "z": "f8e306b2f76e8599",
        "name": "② Перевірка → ③ AQI, згладжування, тривога → ④ запис у PostgreSQL",
        "info": "",
        "x": 700,
        "y": 40,
        "wires": []
    },
    {
        "id": "5b5cfa2ac666b08f",
        "type": "function",
        "z": "f8e306b2f76e8599",
        "name": "Перевірка даних",
        "func": "const bin = msg.topic.split(\"/\")[2];\nconst d = msg.payload;\n\nconst ok = (v, lo, hi) =>\n    typeof v === \"number\" && v >= lo && v <= hi;\n\nconst errors = [];\n\nif (!ok(d.d, 0, 150)) errors.push(\"d\");\nif (d.h !== 120) errors.push(\"h\");\nif (!Number.isInteger(d.ts)) errors.push(\"ts\");\n\nif (errors.length > 0) {\n    const n = (context.get(\"rejected\") || 0) + 1;\n    context.set(\"rejected\", n);\n\n    node.status({\n        fill: \"red\",\n        shape: \"dot\",\n        text: `відхилено: ${n}`\n    });\n\n    msg.payload = {\n        bin: bin,\n        errors: errors,\n        raw: d\n    };\n\n    return [null, msg];\n}\n\nmsg.bin = bin;\nmsg.ts = d.ts;\n\nmsg.payload = {\n    d: d.d,\n    h: d.h\n};\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 120,
        "wires": [
            [
                "a0f31c7201bec54b"
            ],
            [
                "fcbaa2e0330b3f55"
            ]
        ]
    },
    {
        "id": "fcbaa2e0330b3f55",
        "type": "debug",
        "z": "f8e306b2f76e8599",
        "name": "Відхилені",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "counter",
        "x": 580,
        "y": 200,
        "wires": []
    },
    {
        "id": "a0f31c7201bec54b",
        "type": "function",
        "z": "f8e306b2f76e8599",
        "name": "AQI, згладжування, тривога",
        "func": "const ALPHA = 0.2;\nconst ON = 80.0;\nconst OFF = 30.0;\n\nconst d = msg.payload.d;\nconst H = msg.payload.h;\n\nconst fill = (H - d) / H * 100;\n\nconst key = \"st_\" + msg.bin;\nconst st = context.get(key) || {\n    ema: null,\n    alarm: 0,\n    prevEma: null,\n    prevTs: null\n};\n\nst.ema = st.ema === null\n    ? fill\n    : ALPHA * fill + (1 - ALPHA) * st.ema;\n\nlet rate = null;\n\nif (st.prevEma !== null && st.prevTs !== null) {\n    const hours = (msg.ts - st.prevTs) / 3600000;\n    if (hours > 0) {\n        rate = (st.ema - st.prevEma) / hours;\n    }\n}\n\nlet t100 = null;\n\nif (rate !== null && rate > 0) {\n    t100 = (100 - st.ema) / rate;\n}\n\nconst before = st.alarm;\n\nif (st.alarm === 0 && st.ema >= ON) {\n    st.alarm = 1;\n}\n\nif (st.alarm === 1 && st.ema <= OFF) {\n    st.alarm = 0;\n}\n\nst.prevEma = st.ema;\nst.prevTs = msg.ts;\n\ncontext.set(key, st);\n\nmsg.payload = {\n    d: Math.round(d * 10) / 10,\n    h: H,\n    fill: Math.round(fill * 10) / 10,\n    fill_ema: Math.round(st.ema * 10) / 10,\n    rate: rate === null ? null : Math.round(rate * 10) / 10,\n    t100: t100 === null ? null : Math.round(t100 * 10) / 10,\n    alarm: st.alarm\n};\n\nlet alarmMsg = null;\n\nif (st.alarm !== before) {\n    alarmMsg = {\n        topic: `kharkiv/waste/${msg.bin}/alarm`,\n        payload: JSON.stringify({\n            ts: msg.ts,\n            alarm: st.alarm,\n            fill_ema: msg.payload.fill_ema\n        })\n    };\n}\n\nreturn [msg, alarmMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 120,
        "wires": [
